{
  "name": "burnboard",
  "version": "0.1.0",
  "description": "Live and historical monitor for AI coding agent usage — reads OpenAI Codex CLI (~/.codex/sessions) and Claude Code (~/.claude/projects) session transcripts and shows running agents, token consumption over time, per-command/per-prompt trends, a token-economy audit, and subagent lineage.",
  "keywords": [
    "codex",
    "openai-codex",
    "codex-cli",
    "claude-code",
    "anthropic",
    "monitor",
    "dashboard",
    "observability",
    "token-usage",
    "llm",
    "agents",
    "cli"
  ],
  "homepage": "https://github.com/kwpoore-lab/burnboard#readme",
  "bugs": "https://github.com/kwpoore-lab/burnboard/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwpoore-lab/burnboard.git"
  },
  "author": "Ken Poore",
  "license": "MIT",
  "bin": {
    "burnboard": "server.js",
    "burnboard-token-count": "token-count.js"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "files": [
    "server.js",
    "token-count.js",
    "lib",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "optionalDependencies": {
    "js-tiktoken": "1.0.21"
  }
}
